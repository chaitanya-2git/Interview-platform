APP_ENV=local
APP_URL=http://localhost:8000
APP_KEY=replace-with-64-random-hex-characters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blujay_interviews
DB_USERNAME=root
DB_PASSWORD=
SESSION_IDLE_MINUTES=30
# Optional. Relative paths resolve from the project root.
SESSION_SAVE_PATH=storage/sessions
# Firebase Phone Auth for candidate "Forgot password" (SMS OTP). Web config values are public.
# Leave empty to disable self-service reset. See docs/PASSWORD-RESET.md.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
# Google Gemini: reads uploaded resumes to pre-fill name, total experience and skills with years.
# Leave GEMINI_API_KEY empty to disable auto-fill. Free tier inputs may be used by Google to improve products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Help assistant (uses GEMINI_API_KEY). Optional: model for chat answers (defaults to GEMINI_FALLBACK_MODEL) and thinking level.
HELP_BOT_MODEL=
HELP_BOT_THINKING=minimal
