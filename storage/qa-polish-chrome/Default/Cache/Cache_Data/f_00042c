function selectedValue(form, name) {
  const input = form.querySelector(`[name="${name}"]:checked`) || form.querySelector(`[name="${name}"]`);
  return input?.value || '';
}

function selectedLabel(form, name) {
  const checked = form.querySelector(`[name="${name}"]:checked`);
  if (checked) {
    const label=checked.closest('label');
    return label?.querySelector('strong')?.textContent.trim() || label?.querySelector('span:not(.choice-icon)')?.textContent.trim() || checked.value;
  }
  const field = form.querySelector(`[name="${name}"]`);
  if (field?.tagName === 'SELECT') return field.options[field.selectedIndex]?.text || '';
  return field?.value || '';
}

function setupAvailability(form, interviewId = '') {
  const grid = form.querySelector('[data-slot-grid]');
  const status = form.querySelector('[data-slot-status]');
  const timeInput = form.querySelector('[data-time-input]');
  if (!grid || !status || !timeInput) return () => {};
  let request;
  const load = async (keepSelection = false) => {
    const date = selectedValue(form, 'date');
    const duration = selectedValue(form, 'duration');
    const type = selectedValue(form, 'interview_type');
    const support = selectedValue(form, 'support_person_id');
    if (!keepSelection) timeInput.value = '';
    grid.replaceChildren();
    if (!date || !duration || !type || (type === 'TOOL' && !support)) { status.textContent = 'Complete the date and interview setup to see available times.'; return; }
    request?.abort(); request = new AbortController();
    status.innerHTML = '<span class="slot-loader"></span> Checking live availability…';
    try {
      const endpoint = new URL(form.dataset.availabilityUrl, window.location.origin);
      endpoint.searchParams.set('date', date); endpoint.searchParams.set('duration', duration); endpoint.searchParams.set('interview_type', type);
      if (type === 'TOOL') endpoint.searchParams.set('support_person_id', support);
      if (interviewId) endpoint.searchParams.set('interview_id', interviewId);
      const response = await fetch(endpoint, { headers: { Accept: 'application/json' }, credentials: 'same-origin', signal: request.signal });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.message || 'Availability could not be loaded.');
      status.textContent = payload.slots.length ? `${payload.slots.length} times available` : 'No times are available for this setup. Try another date, duration, or support person.';
      payload.slots.forEach(slot => {
        const button = document.createElement('button'); button.type = 'button'; button.className = 'time-slot'; button.dataset.time = slot.start; button.textContent = slot.label;
        if (timeInput.value === slot.start) { button.classList.add('selected'); button.setAttribute('aria-pressed', 'true'); }
        button.addEventListener('click', () => { grid.querySelectorAll('.time-slot').forEach(item => { item.classList.remove('selected'); item.setAttribute('aria-pressed', 'false'); }); button.classList.add('selected'); button.setAttribute('aria-pressed', 'true'); timeInput.value = slot.start; });
        grid.append(button);
      });
    } catch (error) {
      if (error.name === 'AbortError') return;
      const message = document.createElement('span'); message.textContent = error.message;
      const retry = document.createElement('button'); retry.type = 'button'; retry.className = 'text-button'; retry.textContent = 'Try again'; retry.addEventListener('click', () => load(true));
      status.replaceChildren(message, document.createTextNode(' '), retry);
    }
  };
  form.querySelectorAll('[name="date"],[name="duration"],[name="interview_type"],[name="support_person_id"]').forEach(field => field.addEventListener('change', () => load(false)));
  load(true);
  return load;
}

document.querySelectorAll('[data-booking-form]').forEach(form => {
  form.classList.add('enhanced');
  const steps = [...form.querySelectorAll('[data-step]')];
  let current = 1;
  const hrFields = form.querySelector('[data-hr-fields]');
  const supportField = form.querySelector('[data-support-field]');
  const refreshConditional = () => {
    const hrAvailable = selectedValue(form, 'hr_availability') === 'available';
    hrFields.hidden = !hrAvailable; hrFields.querySelectorAll('input').forEach(input => { input.disabled = !hrAvailable; input.required = hrAvailable; });
    const tool = selectedValue(form, 'interview_type') === 'TOOL';
    supportField.hidden = !tool; const select = supportField.querySelector('select'); select.disabled = !tool; select.required = tool;
  };
  const show = (number, scroll = true) => {
    current = number; steps.forEach(step => { const active = Number(step.dataset.step) === current; step.hidden = !active; step.classList.toggle('active', active); });
    form.querySelectorAll('[data-progress]').forEach(item => { const value = Number(item.dataset.progress); item.classList.toggle('active', value === current); item.classList.toggle('complete', value < current); });
    if (current === 4) updateReview();
    if (scroll) form.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  };
  const validate = step => {
    const fields = [...step.querySelectorAll('input,select')].filter(field => !field.disabled && field.type !== 'hidden');
    for (const field of fields) { if (!field.checkValidity()) { field.reportValidity(); return false; } }
    if (Number(step.dataset.step) === 3 && !form.querySelector('[data-time-input]').value) { const status = form.querySelector('[data-slot-status]'); status.textContent = 'Choose one available time to continue.'; status.focus?.(); return false; }
    return true;
  };
  const updateReview = () => {
    ['company_name','job_role','technology_id','interview_round','interview_type','support_person_id','date','duration'].forEach(name => {
      const target = form.querySelector(`[data-review-field="${name}"]`); if (!target) return;
      let label = selectedLabel(form, name) || '—'; if (name === 'duration' && label !== '—') label = selectedValue(form, name) + ' minutes'; if (name === 'date' && selectedValue(form,name)) label = new Date(selectedValue(form,name) + 'T00:00:00').toLocaleDateString('en-IN',{weekday:'short',day:'2-digit',month:'short',year:'numeric'}); target.textContent = label;
    });
    const selectedSlot = form.querySelector('.time-slot.selected'); form.querySelector('[data-review-time]').textContent = selectedSlot?.textContent || selectedValue(form,'time') || '—';
    form.querySelector('[data-review-support]').hidden = selectedValue(form,'interview_type') !== 'TOOL';
  };
  form.querySelectorAll('[data-next]').forEach(button => button.addEventListener('click', () => { const step = steps.find(item => Number(item.dataset.step) === current); if (validate(step)) show(Math.min(4, current + 1)); }));
  form.querySelectorAll('[data-back]').forEach(button => button.addEventListener('click', () => show(Math.max(1, current - 1))));
  form.querySelectorAll('[name="hr_availability"],[name="interview_type"]').forEach(field => field.addEventListener('change', refreshConditional));
  refreshConditional(); setupAvailability(form); show(1, false);
});

