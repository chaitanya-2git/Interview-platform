document.querySelectorAll('[data-file-upload]').forEach(container => {
  const input=container.querySelector('input[type="file"]');const name=container.querySelector('[data-file-name]');const status=container.querySelector('[data-file-status]');if(!input||!name||!status)return;
  input.addEventListener('change',()=>{
    const file=input.files?.[0];if(!file)return;
    const maximum=Number(container.dataset.maxBytes||5*1024*1024);const withinLimit=file.size<=maximum;
    const extension=(file.name.split('.').pop()||'File').toUpperCase();const size=file.size<1024*1024?`${Math.max(1,Math.round(file.size/1024))} KB`:`${(file.size/1024/1024).toFixed(1)} MB`;
    name.textContent=file.name;status.textContent=withinLimit?`${extension} · ${size} · Ready to upload`:`File exceeds ${Math.round(maximum/1024/1024)} MB`;
    container.classList.toggle('file-ready',withinLimit);
    const preview=container.querySelector('[data-photo-preview]');
    if(preview&&file.type.startsWith('image/')){const image=document.createElement('img');image.alt='Selected profile photo preview';const url=URL.createObjectURL(file);image.src=url;image.addEventListener('load',()=>URL.revokeObjectURL(url),{once:true});preview.replaceChildren(image);}
  });
});
